# ==========================================
# CONFIGURACIÓN DE SEGURIDAD JCLIP PRO ULTRA
# ==========================================

# Clave secreta para firma criptográfica de tokens JWT
SECRET_KEY=JCLIP_SUPER_SECRET_KEY_PRODUCTION_READY_2026_XYZ_987654321

# Algoritmo de encriptado y tiempo de expiración
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12

# Protección de Fuerza Bruta (Rate Limit)
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=5
